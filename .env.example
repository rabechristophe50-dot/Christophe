# Copy to .env and fill in. Never commit your real .env.

# Anthropic API key (https://console.anthropic.com/).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model. Defaults to claude-opus-4-8.
# CLAUDE_MODEL=claude-opus-4-8

# Shared secret TradingView must send (header x-webhook-secret or body "secret").
# Leave unset only for local testing — the webhook is unauthenticated without it.
WEBHOOK_SECRET=change-me

# Server port.
PORT=3000

# Account context passed to Claude when sizing trades.
ACCOUNT_BALANCE=10000
RISK_PCT_PER_TRADE=1
